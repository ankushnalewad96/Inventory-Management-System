msgstr "होलसेल किंमत MRP पेक्षा जास्त असू शकत नाही."

#: views.py
msgid "Wholesale price cannot be lower than the purchase price."
msgstr "होलसेल किंमत खरेदी किंमतीपेक्षा कमी असू शकत नाही."

#: views.py
msgid "Wholesale price cannot be more than the retail selling price."
msgstr "होलसेल किंमत रिटेल विक्री किंमतीपेक्षा जास्त असू शकत नाही."

#: add_product.html
msgid "Wholesale price cannot be more than the selling price"
msgstr "होलसेल किंमत विक्री किंमतीपेक्षा जास्त असू शकत नाही"

#: views.py
msgid "Wholesale price must be greater than 0."
msgstr "होलसेल किंमत 0 पेक्षा जास्त असावी."

#: supplier_list.html
msgid "will be permanently deleted. Suppliers that already have purchase bills cannot be deleted — mark them inactive instead."
msgstr "कायमचा काढला जाईल. ज्या सप्लायरची खरेदी बिले आहेत त्यांना काढता येत नाही — त्यांना बंद (Inactive) करा."

#: dashboard.html
msgid "with dues"
msgstr "उधारी असलेले"

#: customer_list.html
msgid "With dues (udhari)"
msgstr "उधारी असलेले"

#: views.py
msgid "Wrong username or password. Please try again."
msgstr "युजरनेम किंवा पासवर्ड चुकीचा आहे. पुन्हा प्रयत्न करा."

#: views.py
msgid "You are not authorized to register a retailer."
msgstr "तुम्हाला दुकान नोंदवण्याची परवानगी नाही."

#: views.py
msgid "You have logged out safely. See you again soon."
msgstr "तुम्ही सुरक्षितपणे लॉग आउट झाला आहात. लवकरच भेटू."

#: views.py
msgid "You must be logged in."
msgstr "आधी लॉगिन करा."

#: views.py
msgid "Your account is not associated with a retailer."
msgstr "तुमचे खाते कोणत्याही दुकानाशी जोडलेले नाही."

#: views.py
msgid "Your account is turned off. Please contact the admin."
msgstr "तुमचे खाते बंद आहे. कृपया ॲडमिनशी संपर्क करा."

#: dashboard.html
msgid "Your shop at a glance"
msgstr "तुमच्या दुकानावर एक नजर"

#: userlogin.html
msgid "Your shop's data is seen only by you and the admin"
msgstr "तुमच्या दुकानाचा डेटा फक्त तुम्ही आणि ॲडमिन पाहू शकता"

#: dashboard_views.py
msgid "₹%(due_amount)s to pay in the next 7 days"
msgstr "पुढील 7 दिवसांत ₹%(due_amount)s भरायचे आहेत"

#: dashboard_views.py
msgid "₹%(overdue_total)s past the due date"
msgstr "₹%(overdue_total)s ची मुदत संपली"

#: account_views.py
msgid "₹%(total)s received from %(customer_name)s (receipt %(receipt)s). %(balance)s"
msgstr "%(customer_name)s यांच्याकडून ₹%(total)s मिळाले (पावती %(receipt)s). %(balance)s"

#: dashboard_views.py
msgid "₹%(total)s to collect"
msgstr "₹%(total)s वसूल करायचे"

#: add_order.html, add_product.html
msgid "➕ Other (Add New)"
msgstr "➕ दुसरे (नवीन जोडा)"
